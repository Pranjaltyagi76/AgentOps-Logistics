# Copy to backend/.env and fill in. Never commit .env.
# Full variable reference: context/deployment.md §3

APP_ENV=local
LOG_LEVEL=INFO

# Local Postgres (Docker or portable binaries). For Neon use the pooled URL with ?sslmode=require
DATABASE_URL=postgresql+psycopg://agentops:agentops_dev@127.0.0.1:5432/agentops
# Optional: direct (non-pooled) URL used only by Alembic migrations
# MIGRATION_DATABASE_URL=
# Empty database for tests (RUN_DB_TESTS=1); each test is rolled back
TEST_DATABASE_URL=postgresql+psycopg://agentops:agentops_dev@127.0.0.1:5432/agentops_test

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Auth. Generate a secret with: uv run python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Used once by scripts/create_owner.py (min. 10 characters)
OWNER_EMAIL=
OWNER_PASSWORD=
# DEMO_LOGIN_ENABLED=true

# Gemini (Phase 6). Put your own Google AI Studio key here; never commit it. Blank = LLM agents off.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_RPM_LIMIT=5
# GEMINI_REQUEST_TIMEOUT_S=20
# LLM_DAILY_RUN_CAP=50

# Copy to backend/.env and fill in. Never commit .env.
# Full variable reference: context/deployment.md §3

APP_ENV=local
LOG_LEVEL=INFO

# Local Docker Postgres (docker compose up -d db). For Neon use the pooled URL with ?sslmode=require
DATABASE_URL=postgresql+psycopg://agentops:agentops_dev@127.0.0.1:5432/agentops
# Optional: direct (non-pooled) URL used only by Alembic migrations
# MIGRATION_DATABASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Added in later phases:
# JWT_SECRET=            (Phase 1)
# GEMINI_API_KEY=        (Phase 6, put your key here yourself)
# GEMINI_MODEL=          (Phase 6)
